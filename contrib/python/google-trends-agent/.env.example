# Fill in your GCP project info and rename this file to ".env".

GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=<TODO: update-this-value>

# Model-serving location. gemini-3.x models are served on "global"; the code
# forces this in app/__init__.py, so leave it as "global".
GOOGLE_CLOUD_LOCATION=global

# Agent Engine hosting region (deployment only).
AGENT_ENGINE_LOCATION=us-central1

# Model names read by the agents (overridable).
MODEL_NAME_AGENT=gemini-3.8-flash
MODEL_NAME_TOOL=gemini-3.8-flash

# Only required for deployment on Agent Engine.
GOOGLE_CLOUD_STORAGE_BUCKET=<TODO: update-this-value>

# Populated by the deployment script (deployment/deploy.py).
AGENT_ENGINE_ID=

# --- Container serving (app/fast_api_app.py, app/app_utils/) ---
# Public base URL advertised in the A2A agent card. Set to the Cloud Run URL
# after deployment; the default matches local `uvicorn`.
APP_URL=http://0.0.0.0:8000
# Version reported in the A2A agent card (the Dockerfile overrides it).
AGENT_VERSION=0.1.0
# Comma-separated CORS origins for the ADK web UI. Empty disables CORS.
ALLOW_ORIGINS=
# Session backend. Leave empty for in-memory; set an ADK session URI
# (e.g. sqlite:///sessions.db) or, for Agent Engine sessions, the engine
# id + its hosting region.
SESSION_SERVICE_URI=
GOOGLE_CLOUD_AGENT_ENGINE_ID=
GOOGLE_CLOUD_AGENT_ENGINE_LOCATION=
# GCS bucket for artifacts. Leave empty for in-memory.
LOGS_BUCKET_NAME=
